# 复制为 .env 并填入真实值。.env 不要提交到 GitHub（.gitignore 必须包含 .env）
# Streamlit Cloud 用 secrets 管理，不用 .env 文件

# Supabase PostgreSQL 直连串（在 Supabase 控制台 → Settings → Database → Connection string → URI 拿）
# 格式：postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Silicon Flow（硅基流动）API Key
# 注册 https://siliconflow.cn 后在「账号 → API 密钥」新建，免费送 14 元 ≈ 1.5 亿次嵌入调用
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
